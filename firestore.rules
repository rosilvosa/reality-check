rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /donations/{id} {
      allow read, write: if false;
    }

    match /community_posts/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['tip', 'urge', 'question', 'vent']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.hearts == 0;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hearts'])
        && (
          request.resource.data.hearts == resource.data.hearts + 1
          || request.resource.data.hearts == resource.data.hearts - 1
        );
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;

      match /hearts/{uid} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
