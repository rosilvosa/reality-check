rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /contact_messages/{id} {
      allow create: if request.auth != null
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000;
      allow read, update, delete: if false;
    }

    match /public_stats/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /checkins/{date}/users/{uid} {
      allow create: if request.auth != null
        && request.auth.uid == uid
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow read, update, delete: if false;
    }

    match /room_amounts/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 5000000
        && request.resource.data.at == request.time
        && request.resource.data.keys().hasOnly(['amount', 'uid', 'at']);
      allow read, update, delete: if false;
    }

    match /community_moderation/{postId} {
      allow read: if request.auth != null && request.auth.token.moderator == true;
      allow write: if false;
    }

    // Curated content, not user posts -- the video list itself lives in the
    // repo. Only the engagement counters are in Firestore, and only Cloud
    // Functions can move them.
    match /video_stats/{videoId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /viewers/{uid} {
        allow read: if false;
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly(['createdAt']);
        allow update, delete: if false;
      }

      match /hearts/{uid} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /community_posts/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['tip', 'urge', 'question', 'vent']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && (
          !('country' in request.resource.data)
          || request.resource.data.country in ['PH', 'US', 'UK', 'AU', 'SG', 'INTL']
        )
        && request.resource.data.hearts == 0;
      allow update: if false;
      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid || request.auth.token.moderator == true);

      match /hearts/{uid} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && request.auth.uid == uid;
      }

      // One report per person per post, enforced by the document id. Nobody can
      // read these back except a moderator, so a report cannot be used to
      // publicly mark someone out.
      match /reports/{uid} {
        allow read: if request.auth != null && request.auth.token.moderator == true;
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly(['createdAt']);
        allow update, delete: if false;
      }
    }
  }
}
